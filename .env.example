DATABASE_URL=            # added automatically by the Vercel Marketplace Neon integration
RESEND_API_KEY=          # sends verification and password-reset emails (Vercel Marketplace → Resend)
EMAIL_FROM=              # e.g. LiveRate <no-reply@yourdomain.com> (a domain verified in Resend)
NEXT_PUBLIC_SITE_URL=    # e.g. https://your-app.vercel.app (fallback: window.location.origin)
GEMINI_API_KEY=          # AI insights (Google AI Studio key). Unset = AI buttons stay hidden
GEMINI_MODEL=            # optional; default gemini-3.5-flash-lite
AI_DAILY_LIMIT=          # optional; AI uses per account per day (default 20)
